{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train",
            "type": "debugpy",
            "request": "launch",
            "module": "incremental_ad.main",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "HF_HOME": "${workspaceFolder}/hf_cache",
                "RUNS_ROOT": "${workspaceFolder}/runs",
                "WANDB_MODE": "disabled",
                "WANDB_PROJECT": "incremental_ad",
                "WANDB_ENTITY": "kirrel-research"

            },
            "justMyCode": true,
            "args": [
                // --- Dispatch ---
                "--op", "train",
                "--experiment-name", "dev",
                "--device", "auto",
                "--dataset", "swat",
                "--model", "mae_tx",

                // --- SWaT dataset ---
                "--swat-window-len", "100",
                "--swat-stride", "50",
                "--swat-normalization", "standard",

                // --- MAE transformer model ---
                "--mae-tx-d-model", "256",
                "--mae-tx-patch-len", "10",
                "--mae-tx-encoder-layers", "2",
                "--mae-tx-encoder-heads", "2",
                "--mae-tx-decoder-layers", "1",
                "--mae-tx-decoder-heads", "2",
                "--mae-tx-mask-ratio", "0.90",

                // --- Training ---
                "--train-seed", "42",
                "--train-epochs", "300",
                "--train-patience", "30",
                "--train-batch-size", "64",
                "--train-optimizer", "adamw",
                "--train-weight-decay", "1e-2",
                "--train-learning-rate", "1e-4",
                "--train-grad-clip", "0.5",
                "--train-scheduler", "cosine",
                "--train-warmup-ratio", "0.1"
            ]
        },
        {
            "name": "Resume training",
            "type": "debugpy",
            "request": "launch",
            "module": "incremental_ad.main",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "HF_HOME": "${workspaceFolder}/hf_cache",
                "RUNS_ROOT": "${workspaceFolder}/runs",
                "WANDB_MODE": "disabled",
                "WANDB_PROJECT": "incremental_ad",
                "WANDB_ENTITY": "kirrel-research"
            },
            "justMyCode": true,
            "args": [
                "--op", "resume",
                "--experiment-name", "dev_resume",
                "--device", "auto",
                "--checkpoint", "runs/dev_20260513_XXXXXX/checkpoints/last.pt"
            ]
        },
        {
            "name": "Eval",
            "type": "debugpy",
            "request": "launch",
            "module": "incremental_ad.main",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "HF_HOME": "${workspaceFolder}/hf_cache",
                "RUNS_ROOT": "${workspaceFolder}/runs",
                "WANDB_MODE": "disabled",
                "WANDB_PROJECT": "incremental_ad",
                "WANDB_ENTITY": "kirrel-research"
            },
            "justMyCode": true,
            "args": [
                "--op", "eval",
                "--experiment-name", "dev_eval",
                "--device", "auto",
                "--dataset", "swat",
                "--checkpoint", "runs/dev_20260513_XXXXXX/checkpoints/best.pt",

                 // --- SWaT dataset --- 
                "--swat-window-len", "100",
                "--swat-stride", "1",
                "--swat-normalization", "standard",

                // --- Eval ---
                "--eval-seed", "0",
                "--eval-split", "test"
            ]
        }
    ]
}
