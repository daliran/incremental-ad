{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pretrain (train + eval)",
            "type": "debugpy",
            "request": "launch",
            "module": "incremental_ad.main",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "HF_HOME": "${workspaceFolder}/hf_cache",
                "RUNS_ROOT": "${workspaceFolder}/experiments",
                "WANDB_MODE": "disabled",
                "WANDB_PROJECT": "incremental_ad",
                "WANDB_ENTITY": "kirrel-research"

            },
            "justMyCode": true,
            "args": [
                // --- Dispatch ---
                "--phase", "pretrain",
                "--experiment", "dev_mae_tx_swat",
                "--device", "auto",
                "--dataset", "swat",
                "--model", "mae_tx",

                // --- SWaT dataset ---
                "--swat-window-len", "100",
                "--swat-stride", "50",
                "--swat-eval-stride", "1",
                "--swat-normalization", "standard",
                "--swat-val-ratio", "0.15",      

                // --- MAE transformer model ---
                "--mae-tx-patch-len", "5",
                "--mae-tx-encoder-embed-dim", "256",
                "--mae-tx-encoder-layers", "2",
                "--mae-tx-encoder-heads", "2",
                "--mae-tx-decoder-embed-dim", "128",
                "--mae-tx-decoder-layers", "1",
                "--mae-tx-decoder-heads", "2",
                "--mae-tx-patch-norm", "false",
                "--mae-tx-mask-ratio", "0.8",
                "--mae-tx-n-eval-passes", "10",

                // --- Training ---
                "--train-seed", "42",
                "--train-epochs", "300",
                "--train-patience", "30",
                "--train-batch-size", "64",
                "--train-optimizer", "adamw",
                "--train-weight-decay", "1e-2",
                "--train-learning-rate", "1e-4",
                "--train-grad-clip", "0.5",
                "--train-scheduler", "cosine",
                "--train-warmup-ratio", "0.1",
                "--train-checkpoint-interval", "0",

                // --- Eval ---
                "--eval-seed", "0",
                "--eval-split", "test",
                "--eval-batch-size", "512",
                "--eval-threshold-strategy", "oracle",
                "--eval-threshold-percentile", "99"
            ]
        },
        {
            "name": "Incremental (pretrain + finetune + merge + eval)",
            "type": "debugpy",
            "request": "launch",
            "module": "incremental_ad.main",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "HF_HOME": "${workspaceFolder}/hf_cache",
                "RUNS_ROOT": "${workspaceFolder}/experiments",
                "WANDB_MODE": "disabled",
                "WANDB_PROJECT": "incremental_ad",
                "WANDB_ENTITY": "kirrel-research"
            },
            "justMyCode": true,
            "args": [
                // --- Dispatch ---
                "--phase", "incremental",
                "--experiment", "dev_mae_tx_swat",
                "--device", "auto",
                "--dataset", "swat",
                "--model", "mae_tx",

                // --- Split + merge ---
                "--partial-ratio", "0.5",
                "--n-finetune", "3",
                "--merge-scale", "1.0",

                // --- SWaT dataset ---
                "--swat-window-len", "100",
                "--swat-stride", "50",
                "--swat-eval-stride", "1",
                "--swat-normalization", "standard",
                "--swat-val-ratio", "0.15",         

                // --- MAE transformer model ---
                "--mae-tx-patch-len", "5",
                "--mae-tx-encoder-embed-dim", "256",
                "--mae-tx-encoder-layers", "2",
                "--mae-tx-encoder-heads", "2",
                "--mae-tx-decoder-embed-dim", "128",
                "--mae-tx-decoder-layers", "1",
                "--mae-tx-decoder-heads", "2",
                "--mae-tx-patch-norm", "false",
                "--mae-tx-mask-ratio", "0.8",
                "--mae-tx-n-eval-passes", "10",

                // --- Base pretrain training ---
                "--train-seed", "42",
                "--train-epochs", "300",
                "--train-patience", "30",
                "--train-batch-size", "64",
                "--train-optimizer", "adamw",
                "--train-weight-decay", "1e-2",
                "--train-learning-rate", "1e-4",
                "--train-grad-clip", "0.5",
                "--train-scheduler", "cosine",
                "--train-warmup-ratio", "0.1",
                "--train-checkpoint-interval", "0",

                // --- Fine-tuning training ---
                "--finetune-seed", "42",
                "--finetune-epochs", "50",
                "--finetune-patience", "10",
                "--finetune-batch-size", "64",
                "--finetune-optimizer", "adamw",
                "--finetune-weight-decay", "1e-2",
                "--finetune-learning-rate", "1e-5",
                "--finetune-grad-clip", "0.5",
                "--finetune-scheduler", "cosine",
                "--finetune-warmup-ratio", "0.1",
                "--finetune-checkpoint-interval", "0",

                // --- Eval (merged model) ---
                "--eval-seed", "0",
                "--eval-split", "test",
                "--eval-batch-size", "512",
                "--eval-threshold-strategy", "oracle",
                "--eval-threshold-percentile", "99"
            ]
        },
        {
            "name": "Eval (standalone)",
            "type": "debugpy",
            "request": "launch",
            "module": "incremental_ad.main",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "HF_HOME": "${workspaceFolder}/hf_cache",
                "RUNS_ROOT": "${workspaceFolder}/experiments",
                "WANDB_MODE": "disabled",
                "WANDB_PROJECT": "incremental_ad",
                "WANDB_ENTITY": "kirrel-research"
            },
            "justMyCode": true,
            "args": [
                "--phase", "eval",
                "--device", "auto",
                "--dataset", "swat",
                "--checkpoint", "${input:evalCheckpoint}",

                 // --- SWaT dataset ---
                "--swat-window-len", "100",
                "--swat-stride", "1",
                "--swat-eval-stride", "1",
                "--swat-normalization", "standard",
                "--swat-val-ratio", "0.15",  

                // --- Eval ---
                "--eval-seed", "0",
                "--eval-split", "test",
                "--eval-batch-size", "512",
                "--eval-threshold-strategy", "oracle",
                "--eval-threshold-percentile", "99"
            ]
        }
    ],
    "inputs": [
        {
            "id": "evalCheckpoint",
            "type": "promptString",
            "description": "Checkpoint to evaluate (relative to workspace)",
            "default": ""
        }
    ]
}
